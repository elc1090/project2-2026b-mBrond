# Porta em que o Flask vai rodar (opcional, o Render define automaticamente via $PORT)
PORT=5000

# Chave secreta para assinatura dos tokens JWT (essencial alterar em producao no Render)
JWT_SECRET=sua_chave_secreta_aqui_para_jwt

# URL de conexao do Banco de Dados PostgreSQL (se omitido, usa SQLite local)
# Exemplo Render: postgresql://usuario:senha@dpg-xxxxx-a/banco
DATABASE_URL=

# Origens permitidas pelo CORS separadas por virgula (ex: https://seu-front.onrender.com,http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Modo de depuracao (True ou False)
DEBUG=False
